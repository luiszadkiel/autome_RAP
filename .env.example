# ============================================
# Web Automation Agent - Configuration
# ============================================
# Copy this file to .env and fill in your values

# OpenAI Configuration (REQUIRED)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OpenAI Model (optional)
# Options: gpt-4o (recommended), gpt-4o-mini (cheaper), gpt-4-turbo
OPENAI_MODEL=gpt-4o

# ============================================
# Browser Configuration
# ============================================

# Run browser in headless mode (no visible window)
HEADLESS=true

# Browser timeout in milliseconds
BROWSER_TIMEOUT=60000

# Maximum steps the agent can take per task
MAX_AGENT_STEPS=20

# ============================================
# Recording & Screenshots
# ============================================

# Automatically record all flows
AUTO_RECORD_FLOWS=true

# Take screenshot on each step
SCREENSHOT_ON_EACH_STEP=false

# ============================================
# Paths (optional - defaults shown)
# ============================================

# DATA_DIR=./data
# DOWNLOADS_DIR=./data/downloads
# SCREENSHOTS_DIR=./data/screenshots
# FLOWS_DIR=./data/flows

# ============================================
# Web Search (optional - for search features)
# ============================================

# Brave Search API (free tier available)
# Get key from: https://brave.com/search/api/
BRAVE_API_KEY=

# Perplexity API (optional alternative)
PERPLEXITY_API_KEY=
